msgid "By A SQUARE"
msgstr "By A SQUARE"

#: scripts/content/ch_frame.gd:51
msgid "«Fie, fie, how franticly I square my talk!»"
msgstr "\"Fie, fie, how franticly I square my talk!\""

#: scripts/content/ch_frame.gd:52
msgid "LONDON\nSEELEY & Co.\n1884"
msgstr "LONDON\nSEELEY & Co.\n1884"


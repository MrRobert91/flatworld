#: data/laminas.json:lam_0
msgid "Una moneda sobre la mesa: desde arriba, un círculo; desde el borde de la mesa, una raya."
msgstr ""

#: data/laminas.json:lam_0
msgid "desde arriba"
msgstr ""

#: data/laminas.json:lam_0
msgid "de canto"
msgstr ""

#: data/laminas.json:lam_1
msgid "La casa de cinco lados: la puerta grande, al Oeste, para los varones; la pequeña, al Este, para las mujeres."
msgstr ""

#: data/laminas.json:lam_1
msgid "varones"
msgstr ""

#: data/laminas.json:lam_1
msgid "mujeres"
msgstr ""

#: data/laminas.json:lam_1
msgid "Norte"
msgstr ""

#: data/laminas.json:lam_10
msgid "«Un Cuadrado montado sobre otro y cuatro rayas que los cosen. Una figura Irregular de muchos lados.»"
msgstr ""

#: data/laminas.json:lam_2
msgid "De la Mujer al Círculo: cada generación, un lado más."
msgstr ""

#: data/laminas.json:lam_3
msgid "En la niebla, los lados se apagan al alejarse. Por lo deprisa que se apagan se conoce el ángulo."
msgstr ""

#: data/laminas.json:lam_3
msgid "más cerca, más tinta"
msgstr ""

#: data/laminas.json:lam_4
msgid "Mitad roja, mitad verde: vistas de canto, una Mujer y un Sacerdote son la misma raya."
msgstr ""

#: data/laminas.json:lam_4
msgid "Sacerdote"
msgstr ""

#: data/laminas.json:lam_5
msgid "El Templo: los Círculos delante, y detrás, por filas, cada cual según sus lados."
msgstr ""

#: data/laminas.json:lam_6
msgid "Linealandia: Líneas y Puntos en una sola Recta. Nadie puede adelantar a nadie."
msgstr ""

#: data/laminas.json:lam_7
msgid "Una Esfera que atraviesa el Plano: un punto, un círculo que crece, que mengua, un punto."
msgstr ""

#: data/laminas.json:lam_8
msgid "Un Punto que se mueve engendra una Línea; la Línea, un Cuadrado; el Cuadrado, hacia Arriba, un Cubo."
msgstr ""

#: data/laminas.json:lam_8
msgid "1"
msgstr ""

#: data/laminas.json:lam_8
msgid "2"
msgstr ""

#: data/laminas.json:lam_8
msgid "4"
msgstr ""

#: data/laminas.json:lam_8
msgid "8"
msgstr ""

#: data/laminas.json:lam_9
msgid "Puntolandia: el Abismo de Ninguna Dimensión. Ello es; y nada hay fuera de Ello."
msgstr ""

